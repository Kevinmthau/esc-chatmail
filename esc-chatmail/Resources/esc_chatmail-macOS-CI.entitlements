<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The Mac test host's entitlements in CI only, chosen by Configuration/CI-MacTestHost.xcconfig
  (architecture review 2026-11, mac-platform#1, testing-ci-release#3). The same as
  esc_chatmail-macOS.entitlements without keychain-access-groups, which needs a provisioning
  profile CI does not have. The App Sandbox is named here as well as generated from the
  project's ENABLE_APP_SANDBOX, so that this file says on its own that the host it signs is
  sandboxed: verify-mac-test-host.sh and MacUnitTestHostGuard refuse a host without it.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
