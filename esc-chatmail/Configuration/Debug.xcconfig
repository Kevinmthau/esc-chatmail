// Shared debug configuration.
// These values are shipped in the client bundle and are required for local builds.

GOOGLE_CLIENT_ID = 999923476073-b4m4r3o96gv30rqmo71qo210oa46au74.apps.googleusercontent.com
GOOGLE_API_KEY = AIzaSyAnVWdfhCGB0raSuwStoMl6U3368E9-gxk
GOOGLE_PROJECT_NUMBER = 999923476073
GOOGLE_PROJECT_ID = esc-gmail-client
GOOGLE_REDIRECT_URI = com.googleusercontent.apps.999923476073-b4m4r3o96gv30rqmo71qo210oa46au74

// Keep build warnings at the same priority as build failures.
SWIFT_TREAT_WARNINGS_AS_ERRORS = YES
GCC_TREAT_WARNINGS_AS_ERRORS = YES

// On macOS, GoogleSignIn's umbrella header leaves out its two iOS-only headers, so clang reports
// the umbrella as incomplete when the app imports the module, and the line above turns that into
// an error before any Swift compiles. Silence only that warning, only for the Mac.
OTHER_SWIFT_FLAGS[sdk=macosx*] = $(inherited) -Xcc -Wno-incomplete-umbrella
